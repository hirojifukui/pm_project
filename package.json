{
  "name": "travel-expense-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test:unit": "vitest run --dir tests/unit",
    "test:contract": "vitest run --dir tests/contract",
    "test:e2e": "playwright test",
    "scan:pii": "node scripts/scan-pii.mjs",
    "scan:i18n": "node scripts/scan-i18n.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:contract && npm run scan:pii && npm run scan:i18n",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "better-sqlite3": "^11.3.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "iron-session": "^8.0.3",
    "next": "16.4.2",
    "pino": "^9.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^2.1.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.48.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.1",
    "typescript": "^5",
    "vitest": "^2.1.3"
  }
